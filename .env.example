# Copy this file to  .env  (same folder) and paste your keys after the = sign.
# .env is in .gitignore - never commit it, never share it.
#
# VirusTotal (free):  https://www.virustotal.com  -> profile icon -> API key
VT_API_KEY=
# NVD (free, optional but ~10x faster):  https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Face scan: % match needed to sign in (default 95, lowest allowed 80). Optional.
FACE_MATCH_PERCENT=95
