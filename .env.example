# Copy this file to  .env  (same folder) and paste your keys after the = sign.
# .env is in .gitignore - never commit it, never share it.
#
# VirusTotal (free):  https://www.virustotal.com  -> profile icon -> API key
VT_API_KEY=
# NVD (free, optional but ~10x faster):  https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Updates (YARA rules + AI model). The dashboard has only an "Update now" button and a 48-hour auto check;
# the source is set here by whoever ships the app, never typed into the dashboard.
UPDATE_REPO=
UPDATE_BRANCH=main
# Token only for a PRIVATE repository (GitHub: Settings -> Developer settings -> fine-grained token, read-only).
GIT_TOKEN=
